  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShopNPC
  NPCName: "\uC0C1\uC778"
  dialogueLines:
  - "\uC774 \uD0D1\uC744 \uC5EC\uD589\uD558\uB294 \uBAA8\uD5D8\uAC00\uAD6C\uB098?"
  - "\uAC12\uC9C4\uAC70\uB77C\uB3C4 \uC788\uC5B4?"
  - "\uC7A5\uBE44\uB3C4 \uC88B\uACE0 \uBAAC\uC2A4\uD130\uC758 \uC804\uB9AC\uD488\uC774\uC5EC\uB3C4
    \uC88B\uC544"
  addDialogueLine:
  - "\uB098\uB294 \uAC00\uB054 \uC5EC\uAE30\uC11C \uC7A5\uBE44\uB4E4\uC744 \uD314\uACE0\uC788\uC5B4"
  - "\uC774 \uD0D1\uC5D0 \uB300\uD574\uC11C\uB294 \uB098\uB3C4 \uC544\uB294 \uAC83\uC774
    \uBCC4\uB85C \uC5C6\uC5B4"
  - "\uD558\uC9C0\uB9CC \uC774 \uD0D1\uC744 \uB9CE\uC774 \uB3CC\uC544\uB2E4\uB140
    \uBD24\uB294\uB370 \n\uC62C\uB77C\uAC00\uB3C4 \uB05D\uC774 \uC548\uBCF4\uC5EC
    \n\uC544\uB9C8 \uCE35\uC774 \uBB34\uD55C\uC778 \uD0D1\uC778\uAC70 \uAC19\uC544"
  selectAText: "\uD310\uB9E4\uD558\uAE30"
  selectBText: "\uC815\uBCF4\uBB3B\uAE30"
